# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# Local video cache / index (never commit cached videos or the cache index)
cache/
*.mp4
*.mkv
index.json

# Per-device runtime settings (e.g. the cache root path set via the web UI)
app/config/settings.json

# The live library store (see library.py) -- generated/migrated at runtime,
# same category as settings.json above. Also ignore the .bak copies taken
# before every programmatic edit, and library.csv's own pre-migration
# backup, so a real deployment's data never gets committed by accident.
app/config/library.db
app/config/*.bak

# Deploy-target-local runtime data (e.g. fallback video cache dir when no
# --cache-root is given to a deploy/<target>/install.sh)
deploy/*/data/

# deploy/macos build output (build.sh regenerates all of this)
deploy/macos/.venv-build/
deploy/macos/build/
deploy/macos/dist/
deploy/macos/icon.icns
deploy/macos/icon.iconset/
deploy/macos/icon_source.png

# Local Claude Code guidance -- not part of the public-facing repo
CLAUDE.md