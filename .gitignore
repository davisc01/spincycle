# macOS
.DS_Store

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# Local video cache / index (never commit cached videos or the cache index)
cache/
*.mp4
*.mkv
index.json
yt-dlp-archive.txt

# Per-device runtime settings (e.g. the cache root path set via the web UI)
app/config/settings.json

# Deploy-target-local runtime data (e.g. fallback video cache dir when no
# --cache-root is given to a deploy/<target>/install.sh)
deploy/*/data/